<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magic\WebhookConnector\Api\StatusManagementInterface"
                type="Magic\WebhookConnector\Model\StatusManagement"/>
    <preference for="Magic\WebhookConnector\Api\Data\StatusInterface"
                type="Magic\WebhookConnector\Model\Data\Status"/>
    <preference for="Magic\WebhookConnector\Api\ReviewManagementInterface"
                type="Magic\WebhookConnector\Model\ReviewManagement"/>
    <preference for="Magic\WebhookConnector\Api\Data\ReviewInterface"
                type="Magic\WebhookConnector\Model\Data\Review"/>
    <preference for="Magic\WebhookConnector\Api\ReviewWriteManagementInterface"
                type="Magic\WebhookConnector\Model\ReviewWriteManagement"/>
    <preference for="Magic\WebhookConnector\Api\Data\ReviewInputInterface"
                type="Magic\WebhookConnector\Model\Data\ReviewInput"/>
    <type name="Magento\InventoryApi\Api\SourceRepositoryInterface">
        <plugin name="magic_webhookconnector_source_repository_webhook"
                type="Magic\WebhookConnector\Plugin\SourceRepositoryWebhookPlugin"/>
    </type>
    <virtualType name="Magic\WebhookConnector\Plugin\SourceItemsSaveWebhookPlugin"
                 type="Magic\WebhookConnector\Plugin\SourceItemsWebhookPlugin">
        <arguments>
            <argument name="eventType" xsi:type="string">stock.updated</argument>
        </arguments>
    </virtualType>
    <virtualType name="Magic\WebhookConnector\Plugin\SourceItemsDeleteWebhookPlugin"
                 type="Magic\WebhookConnector\Plugin\SourceItemsWebhookPlugin">
        <arguments>
            <argument name="eventType" xsi:type="string">stock.deleted</argument>
        </arguments>
    </virtualType>
    <type name="Magento\InventoryApi\Api\SourceItemsSaveInterface">
        <plugin name="magic_webhookconnector_source_items_save_webhook"
                type="Magic\WebhookConnector\Plugin\SourceItemsSaveWebhookPlugin"/>
    </type>
    <type name="Magento\InventoryApi\Api\SourceItemsDeleteInterface">
        <plugin name="magic_webhookconnector_source_items_delete_webhook"
                type="Magic\WebhookConnector\Plugin\SourceItemsDeleteWebhookPlugin"/>
    </type>
</config>
