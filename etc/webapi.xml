<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/magic-webhook-connector/status" method="GET">
        <service class="Magic\WebhookConnector\Model\StatusManagement" method="getStatus"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/magic-webhook-connector/reviews" method="GET">
        <service class="Magic\WebhookConnector\Api\ReviewManagementInterface" method="getList"/>
        <resources>
            <resource ref="Magic_WebhookConnector::reviews"/>
        </resources>
    </route>
    <route url="/V1/magic-webhook-connector/reviews/:reviewId" method="GET">
        <service class="Magic\WebhookConnector\Api\ReviewManagementInterface" method="getById"/>
        <resources>
            <resource ref="Magic_WebhookConnector::reviews"/>
        </resources>
    </route>
    <route url="/V1/magic-webhook-connector/reviews" method="POST">
        <service class="Magic\WebhookConnector\Api\ReviewWriteManagementInterface" method="create"/>
        <resources>
            <resource ref="Magic_WebhookConnector::reviews_write"/>
        </resources>
    </route>
    <route url="/V1/magic-webhook-connector/reviews/:reviewId" method="PUT">
        <service class="Magic\WebhookConnector\Api\ReviewWriteManagementInterface" method="update"/>
        <resources>
            <resource ref="Magic_WebhookConnector::reviews_write"/>
        </resources>
    </route>
    <route url="/V1/magic-webhook-connector/reviews/:reviewId" method="DELETE">
        <service class="Magic\WebhookConnector\Api\ReviewWriteManagementInterface" method="delete"/>
        <resources>
            <resource ref="Magic_WebhookConnector::reviews_write"/>
        </resources>
    </route>
    <route url="/V1/magic-webhook-connector/discounts" method="POST">
        <service class="Magic\WebhookConnector\Model\DiscountWriteManagement" method="create"/>
        <resources>
            <resource ref="Magento_SalesRule::quote"/>
        </resources>
    </route>
    <route url="/V1/magic-webhook-connector/discounts/:ruleId" method="PUT">
        <service class="Magic\WebhookConnector\Model\DiscountWriteManagement" method="update"/>
        <resources>
            <resource ref="Magento_SalesRule::quote"/>
        </resources>
    </route>
    <route url="/V1/magic-webhook-connector/discounts/:ruleId" method="DELETE">
        <service class="Magic\WebhookConnector\Model\DiscountWriteManagement" method="delete"/>
        <resources>
            <resource ref="Magento_SalesRule::quote"/>
        </resources>
    </route>
    <route url="/V1/magic-webhook-connector/discounts/coupons/:couponId" method="DELETE">
        <service class="Magic\WebhookConnector\Model\DiscountWriteManagement" method="deleteCoupon"/>
        <resources>
            <resource ref="Magento_SalesRule::quote"/>
        </resources>
    </route>
</routes>
